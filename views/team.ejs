<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

<body>
    <%- include('partials/nav') %>
    <main>
        <section>
            <h2>Meet a Sample Studio</h2>
            <p>The Overview page lists five roles every game team needs. This page builds a made-up studio that fills
                each of them. Every name, email, and detail is randomly generated by the Faker package, so refresh
                the page to meet a brand new team.</p>
            <div class="card studio-card">
                <h3><%= studio.name %></h3>
                <p>Based in <%= studio.city %> · Founded <%= studio.founded %></p>
            </div>
        </section>

        <section>
            <h2>The Team</h2>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Experience</th>
                            <th>Favorite Engine</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% team.forEach(member => { %>
                            <tr>
                                <td><%= member.role %></td>
                                <td><%= member.name %></td>
                                <td><%= member.email %></td>
                                <td><%= member.years %> <%= member.years === 1 ? 'year' : 'years' %></td>
                                <td><%= member.engine %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <p><a href="/team">Generate a new team</a></p>
        </section>

        <section class="sources">
            <h2>Sources</h2>
            <ul>
                <li>Random data generated with <a href="https://fakerjs.dev" target="_blank" rel="noopener">@faker-js/faker</a></li>
            </ul>
        </section>
    </main>
    <%- include('partials/footer') %>
</body>

</html>
